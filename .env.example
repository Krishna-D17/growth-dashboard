# SocialScope Application Environment Configuration Example
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://socialscope:socialscope@127.0.0.1:5433/socialscope

# Scheduler settings
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MINUTES=5
MAX_COLLECTION_RETRIES=2
RETRY_BACKOFF_SECONDS=5

# AI Insights Layer (Optional External LLM Configuration)
# Options for AI_PROVIDER: "mock" (default, deterministic testing), "openai" (external API)
AI_PROVIDER=mock
AI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gpt-4o-mini

